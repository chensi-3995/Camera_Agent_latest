{
  "storage": {
    "base_dir": "D:\\camera_agent_data",
    "database_path": "D:\\camera_agent_data\\security_events.db",
    "session_prefix": "local_direct"
  },
  "capture": {
    "mode": "local_direct",
    "segment_seconds": 120,
    "cleanup_days": 7
  },
  "cameras": [
    {
      "camera_id": "cam01",
      "name": "1号摄像头",
      "location": "研究院内网",
      "rtsp_url": "rtsp://admin:YOUR_CAMERA_PASSWORD@YOUR_CAMERA_01_IP:554/stream2",
      "enabled": true
    },
    {
      "camera_id": "cam02",
      "name": "2号摄像头",
      "location": "研究院内网",
      "rtsp_url": "rtsp://admin:YOUR_CAMERA_PASSWORD@YOUR_CAMERA_02_IP:554/stream2",
      "enabled": true
    }
  ],
  "vision_llm": {
    "provider": "openai_compatible",
    "base_url": "http://YOUR_QWEN_VL_SERVER:8000/v1",
    "model": "qwen2_5_VL",
    "api_key": "EMPTY",
    "timeout_seconds": 60
  },
  "text_llm": {
    "provider": "ollama",
    "base_url": "http://127.0.0.1:11434",
    "model": "qwen2.5",
    "timeout_seconds": 60
  },
  "embedding": {
    "base_url": "http://127.0.0.1:8080",
    "endpoint": "/embed",
    "dimension": 1024
  },
  "qdrant": {
    "url": "http://127.0.0.1:6333",
    "collection": "camera_agent_events"
  },
  "feishu": {
    "enabled": false,
    "app_id": "YOUR_FEISHU_APP_ID",
    "app_secret": "YOUR_FEISHU_APP_SECRET",
    "chat_id": "YOUR_FEISHU_CHAT_ID"
  },
  "dashboard": {
    "xiaoan_enabled": true,
    "asr_url": "http://127.0.0.1:8070/asr",
    "tts_url": "http://127.0.0.1:8090/tts",
    "wake_words": ["您好，小安", "你好，小安", "小安"]
  }
}
